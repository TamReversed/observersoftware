<%
  const links = [['Work', '/work'], ['Products', '/products'], ['Insights', '/blog'], ['About', '/#about'], ['Contact', '/contact']];
  const here = (href) => href !== '/#about' && (path === href || path.startsWith(href + '/'));
%>
<% if (typeof preview !== 'undefined' && preview) { %><div class="preview-bar" role="status">Preview: you are seeing unpublished changes. Visitors cannot see this. <a href="<%= path %>">Exit preview</a></div><% } %>
<header class="nav<%= (typeof navOver !== 'undefined' && navOver) ? ' nav--over' : '' %>" id="nav">
  <div class="wrap nav__inner">
    <a class="nav__logo" href="/" aria-label="Observer, home"><img src="/assets/brand/observer-wordmark.svg" alt="Observer" width="117" height="32"></a>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Menu"><span></span><span></span></button>
    <nav class="nav__links" id="nav-links" aria-label="Primary">
      <% links.forEach(function (l) { %><a href="<%= l[1] %>"<%- here(l[1]) ? ' aria-current="page"' : '' %>><%= l[0] %></a>
      <% }); %>
    </nav>
  </div>
</header>
