# Dependencies
node_modules/

# Environment variables
.env
.env.local
.env.production

# Data files (user-generated content)
# Exclude most data files, but allow some to be tracked for initial migration
data/*
!data/capabilities.json
!data/work.json
!data/posts.json
# Exclude sensitive/user-generated data files
data/messages.json
data/users.json

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Build outputs
dist/
build/

# Misc
*.tmp
*.temp

.claude/launch.json
refs/raw/

# iCloud sync conflict copies (e.g. "file 2.webp")
* [0-9].*

# generated image cache and uploads (live on the data volume)
data/cache/
data/uploads/
