# Required Environment Variables

# Session secret (REQUIRED in production)
# Generate a strong random string for production
SESSION_SECRET=your-secret-key-here-change-in-production

# Optional Configuration

# Server port (default: 3000)
PORT=3000

# Environment mode: production or development
NODE_ENV=development

# Data directory for JSON files (default: ./data)
# On Railway, set this to /data to use persistent volume
DATA_DIR=./data

# Database Configuration (optional)
# If DATABASE_URL is set, the app will use PostgreSQL instead of JSON files
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Admin Credentials (defaults shown, change in production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# WebAuthn Configuration (optional)
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=Observer
# WEBAUTHN_ORIGIN=http://localhost:3000

# Contact form email notifications (Resend: https://resend.com)
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=you@example.com
# CONTACT_FROM_EMAIL="Observer <noreply@yourdomain.com>"

# Public site URL (used for sitemap, canonical tags, social cards)
# SITE_URL=https://observersoftware.io

# Seed sample posts/work/products on an empty site (default: off)
# SEED_SAMPLE_CONTENT=true

# Legal pages (optional; omitted from /privacy and /terms until set)
# LEGAL_ADDRESS="123 Example St, City, ST 00000"
# GOVERNING_STATE=Delaware

# Optional: key used to encrypt one-time-code secrets at rest. Set once and never change it.
# If unset, a key derived from SESSION_SECRET is used (changing SESSION_SECRET then breaks codes).
# TOTP_ENCRYPTION_KEY=
